# Copy to .env and fill in before docker-compose up
POSTGRES_USER=dine
POSTGRES_PASSWORD=admin
POSTGRES_DB=db
SECRET_KEY=generate-a-long-random-secret
JWT_SECRET_KEY=generate-another-long-random-secret

# Optional. Leave empty — QR export auto-detects the live ngrok tunnel
# via http://host.docker.internal:4040 (start: ngrok http 3080).
# Only set this if you use a stable custom domain.
PUBLIC_BASE_URL=
NGROK_API_URL=http://host.docker.internal:4040

SESSION_COOKIE_SECURE=0
FLASK_ENV=production
DATABASE_URL=postgresql://dine:admin@db:5432/db

# Locale
DEFAULT_LANGUAGE=en
CURRENCY=PKR

# Redis (Socket.IO message queue)
REDIS_URL=redis://redis:6379/0

# MinIO object storage for menu image uploads
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dineflow
MINIO_SECURE=0

# Payments stub (gateway integration later)
PAYMENTS_ENABLED=0
